# Copy to .env (never commit .env). Values below are placeholders.
# Day 6 pgvector container (port 55433, database day6_lab, table chunks, strategy B)
DATABASE_URL=postgresql://day6:<password-from-day6-compose>@127.0.0.1:55433/day6_lab
OPENROUTER_API_KEY=<your-openrouter-key>
EMBEDDING_MODEL=openai/text-embedding-3-small
AGENT_MODEL=anthropic/claude-haiku-5.5
# Optional: path of the Day 6 repo (default: sibling folder K5-L3A-DAY06-2A202603422-DataIngestion)
# DAY6_ROOT=D:/AIVin/K5-L3A-DAY06-2A202603422-DataIngestion
